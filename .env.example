# Copy to .env (git-ignored) and replace every CHANGE_ME. Generate random values with:
#   openssl rand -hex 32
# or run ./scripts/init-env.sh, which writes a .env with random secrets for you.

# ---- PostgreSQL (container superuser; only used for setup and the legacy data import)
POSTGRES_USER=airbnb_admin
POSTGRES_PASSWORD=CHANGE_ME

# ---- One database login per service (each owns only its own schema)
AUTH_DB_PASSWORD=CHANGE_ME
CATALOG_DB_PASSWORD=CHANGE_ME
BOOKING_DB_PASSWORD=CHANGE_ME
REVIEW_DB_PASSWORD=CHANGE_ME

# ---- Security
# HS256 signing key for login tokens: at least 32 characters. Changing it logs everyone out.
JWT_SECRET=CHANGE_ME_AT_LEAST_32_CHARACTERS_LONG
# Shared secret for service-to-service (/internal/**) calls: at least 16 characters.
INTERNAL_API_TOKEN=CHANGE_ME

# ---- Razorpay: TEST mode keys only (Dashboard > Account & Settings > API Keys, test mode).
# Leave empty to disable online payments (pay at hotel keeps working). Live keys (rzp_live_...) are refused.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Only needed if you configure a webhook (e.g. through a tunnel to http://localhost:8080/api/v1/payments/webhook).
RAZORPAY_WEBHOOK_SECRET=

# ---- Optional
# FRONTEND_PORT=3000
# GATEWAY_PORT=8080
# BOOKING_HOLD_MINUTES=15
# TZ=Asia/Kolkata
