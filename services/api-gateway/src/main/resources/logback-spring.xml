<?xml version="1.0" encoding="UTF-8"?>
<!--
  Gateway logs, each in its own file under ${LOG_DIR} (Docker: ./logs/api-gateway/ on the host) and on the console:
    app.log     gateway messages (errors, session checks, startup)
    access.log  one line per request at the edge (logger "ACCESS", see RequestLoggingWebFilter)
    audit.log   rejected requests: 401 / 403 / expired sessions (logger "AUDIT")
  Every line has req=<request id>; the same id is in nginx's and every service's logs.
-->
<configuration>
    <springProperty scope="context" name="SERVICE" source="spring.application.name" defaultValue="api-gateway"/>
    <springProperty scope="context" name="LOG_DIR" source="app.logging.dir" defaultValue="logs"/>

    <property name="APP_PATTERN" value="%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [${SERVICE}] [%thread] %logger{40} - %msg%n%ex"/>
    <property name="EVENT_PATTERN" value="%d{yyyy-MM-dd HH:mm:ss.SSS} [${SERVICE}] %msg%n"/>

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder><pattern>${APP_PATTERN}</pattern></encoder>
    </appender>
    <appender name="APP_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_DIR}/app.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_DIR}/app.%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
            <maxFileSize>20MB</maxFileSize><maxHistory>14</maxHistory><totalSizeCap>1GB</totalSizeCap>
        </rollingPolicy>
        <encoder><pattern>${APP_PATTERN}</pattern></encoder>
    </appender>
    <appender name="ACCESS_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_DIR}/access.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_DIR}/access.%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
            <maxFileSize>20MB</maxFileSize><maxHistory>30</maxHistory><totalSizeCap>1GB</totalSizeCap>
        </rollingPolicy>
        <encoder><pattern>${EVENT_PATTERN}</pattern></encoder>
    </appender>
    <appender name="AUDIT_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_DIR}/audit.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_DIR}/audit.%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
            <maxFileSize>20MB</maxFileSize><maxHistory>90</maxHistory><totalSizeCap>2GB</totalSizeCap>
        </rollingPolicy>
        <encoder><pattern>${EVENT_PATTERN}</pattern></encoder>
    </appender>

    <logger name="ACCESS" level="INFO" additivity="false">
        <appender-ref ref="ACCESS_FILE"/>
        <appender-ref ref="CONSOLE"/>
    </logger>
    <logger name="AUDIT" level="INFO" additivity="false">
        <appender-ref ref="AUDIT_FILE"/>
        <appender-ref ref="CONSOLE"/>
    </logger>
    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="APP_FILE"/>
    </root>
</configuration>
